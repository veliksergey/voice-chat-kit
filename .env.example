# Copy to .env (git-ignored). Never commit real values.

# Required from Phase 1: Claude API key for apps/server.
ANTHROPIC_API_KEY=

# Required from Phase 2: Deepgram key; the server mints short-lived tokens from it.
DEEPGRAM_API_KEY=

# apps/server listen port.
PORT=3000

# Origin allowed to call apps/server (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
