# Copy to .env at the repository root (git-ignored). Never commit real values.

# Required from Phase 1: Claude API key for apps/server (or sign in with `ant auth login`).
ANTHROPIC_API_KEY=

# Optional Claude settings (defaults: claude-opus-5-5, low, 4096). Prefixed VOICE_CHAT_ because
# Claude Code exports CLAUDE_EFFORT into its shells and would otherwise override them.
VOICE_CHAT_MODEL=
VOICE_CHAT_EFFORT=
VOICE_CHAT_MAX_TOKENS=
VOICE_CHAT_SYSTEM_PROMPT=

# Required from Phase 2: Deepgram key; the server mints short-lived tokens from it.
DEEPGRAM_API_KEY=

# apps/server bind address and port. Keep loopback: /api/chat spends your Claude credits and
# v1 has no authentication. Set HOST=0.0.0.0 only behind your own auth/proxy.
HOST=127.0.0.1
PORT=3000

# Origin allowed to call apps/server (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
